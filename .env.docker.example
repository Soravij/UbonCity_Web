# 1 ไฟล์ = 1 site. site ใหม่ให้ copy เป็น .env.docker.<site>
# แล้ว build ใหม่ เพราะ NEXT_PUBLIC_* / VITE_* ถูก bake ตอน build

# Backend
NODE_ENV=production
PORT=5000
DB_HOST=mysql
DB_PORT=3306
DB_NAME=uboncity
DB_USER=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:5000

# Collector (host machine)
COLLECTOR_SYNC_BASE_URL=http://host.docker.internal:5062
COLLECTOR_PUBLIC_BASE_URL=http://host.docker.internal:5062

# Google Maps
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key

# Frontend (Next.js) - bake at build time
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXING=false

# Admin (Vite) - bake at build time
VITE_API_URL=http://localhost:5000/api
VITE_FRONTEND_URL=http://localhost:3000
VITE_COLLECTOR_BASE_URL=http://host.docker.internal:5062